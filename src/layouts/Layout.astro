---
import "../styles/global.css";
import heroFont from "@fontsource/geist-sans/files/geist-sans-latin-700-normal.woff2?url";
import { latestRelease } from "../release";
import { LANGUAGE_KEY, SITE_LANGUAGES, direction, homePath, ogLocale } from "../i18n/site";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /** Other languages of this page, for `hreflang` links. */
  alternates?: { hreflang: string; path: string }[];
}

const {
  title = "Snap2Link · paste screenshots into Claude Code, Cursor, or any terminal AI",
  description = "Hotkey → drag a region → public share link lands in your clipboard. One keystroke, on Windows, macOS, and Linux. Free, open source, MIT licensed.",
  lang = "en",
  alternates = [],
} = Astro.props;

const SITE_URL = Astro.site ?? new URL("https://snap2link.app");
const { version } = await latestRelease();
// `Astro.url.href` already includes the trailing slash for the index — keep it
// stable so the same canonical is emitted for / and /index.html requests.
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = new URL("/og.png", SITE_URL).toString();
// The English home page sends visitors to their language: the one they picked
// before, or else the closest one their browser asks for. Search engines get
// English, and every language keeps its own address.
const redirects = Astro.url.pathname === "/";
const languagePaths = Object.fromEntries(SITE_LANGUAGES.map(({ code }) => [code, homePath(code)]));

// Schema.org SoftwareApplication block — Google uses this to surface the
// app in rich results (download button, OS chips, ratings) and to crawl
// the GitHub release artefacts as the canonical install source.
const softwareLD = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Snap2Link",
  alternateName: "Snap2Link: screenshot to link",
  description:
    "Hotkey-driven screenshot tool that uploads to Snap2Link hosting or your own Google Drive and copies a public share link to your clipboard. Built for AI workflows: Claude Code, Cursor, ChatGPT, Aider.",
  applicationCategory: "ProductivityApplication",
  operatingSystem: "Windows 10, Windows 11, macOS 12, Linux, Android 8",
  softwareVersion: version,
  url: SITE_URL.toString(),
  downloadUrl: "https://github.com/amys94fr/Snap2Link/releases/latest",
  installUrl: "https://github.com/amys94fr/Snap2Link/releases/latest",
  license: "https://opensource.org/license/mit",
  author: {
    "@type": "Person",
    name: "Steven Abittan",
    url: "https://github.com/amys94fr",
  },
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: [
    "Drag-to-capture screen region overlay",
    "Full-screen capture (single monitor)",
    "Per-window capture from a picker of open windows",
    "Snap2Link hosting with no account, or a free account with kept links",
    "Upload to your own Google Drive (drive.file scope)",
    "Public share link copied to clipboard",
    "Screenshots shared as links: nothing saved on the receiver's phone or computer",
    "Built-in annotator (pen, rectangle, circle, arrow, text, blur)",
    "Up to 3 global shortcuts, each with its own capture mode",
    "History of links with thumbnails, in the app and online",
    "MCP server so Claude Code and opencode can read links, even over SSH",
    "Auto-cleanup of old screenshots on Drive",
    "Built-in auto-updater",
    "20 languages, including right-to-left",
    "Cross-platform: Windows, macOS, Linux",
  ],
  keywords:
    "screenshot, screen capture, share link, google drive, claude code, cursor, mcp, ai tools, productivity, tauri, open source",
};
---

<!doctype html>
<html lang={lang} dir={direction(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates.map(({ hreflang, path }) => (
        <link rel="alternate" hreflang={hreflang} href={new URL(path, SITE_URL).toString()} />
      ))
    }
    {
      redirects && (
        <script is:inline define:vars={{ languagePaths, key: LANGUAGE_KEY }}>
          (function () {
            var closest = function (code) {
              if (!code) return undefined;
              if (languagePaths[code]) return code;
              var base = code.split("-")[0].toLowerCase();
              if (base === "zh") return /TW|HK|MO|Hant/i.test(code) ? "zh-TW" : "zh-CN";
              if (base === "pt") return "pt-BR";
              return languagePaths[base] ? base : undefined;
            };
            var choice;
            try {
              choice = closest(localStorage.getItem(key));
            } catch (e) {}
            if (!choice) {
              var wanted = navigator.languages || [navigator.language];
              for (var i = 0; i < wanted.length && !choice; i++) choice = closest(wanted[i]);
            }
            if (choice && choice !== "en") location.replace(languagePaths[choice] + location.hash);
          })();
        </script>
      )
    }

    <link rel="icon" href="/assets/logo-app-icon.png" />
    <link rel="apple-touch-icon" href="/assets/logo-app-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Snap2Link" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale(lang)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0F172A" />
    <meta name="generator" content={Astro.generator} />

    <!-- Speed up the GitHub round-trips we link to repeatedly -->
    <link rel="preconnect" href="https://github.com" crossorigin />
    <link rel="dns-prefetch" href="https://github.com" />

    <!-- Preload Geist 700 (hero LCP) -->
    <link
      rel="preload"
      href={heroFont}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <slot name="head" />

    <!-- Structured data for app rich results -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(softwareLD)}
    />
  </head>
  <body>
    <slot />

    <script>
      // Refresh GitHub metrics (stars + total downloads) client-side so
      // the figures stay accurate between deploys. Falls back silently
      // to the build-time values rendered into [data-gh-*] if the API
      // is unreachable (rate-limited, offline, etc.).
      (async () => {
        const headers = { Accept: "application/vnd.github+json" };
        const set = (selector: string, value: string | number) => {
          const text = String(value);
          document
            .querySelectorAll<HTMLElement>(selector)
            .forEach((el) => {
              if (el.textContent !== text) el.textContent = text;
            });
        };

        // 1. Stars — single repo metadata fetch
        try {
          const r = await fetch(
            "https://api.github.com/repos/amys94fr/Snap2Link",
            { headers },
          );
          if (r.ok) {
            const data = (await r.json()) as { stargazers_count?: number };
            if (typeof data.stargazers_count === "number") {
              set("[data-gh-stars]", data.stargazers_count);
            }
          }
        } catch {
          /* keep build-time value */
        }

        // 2. Downloads — sum across every asset of every release
        try {
          const r = await fetch(
            "https://api.github.com/repos/amys94fr/Snap2Link/releases?per_page=100",
            { headers },
          );
          if (r.ok) {
            type R = {
              tag_name?: string;
              draft?: boolean;
              prerelease?: boolean;
              html_url?: string;
              assets?: Array<{ name?: string; download_count?: number; browser_download_url?: string }>;
            };
            const releases = (await r.json()) as R[];
            // Newest first. Android releases have their own android-v tags.
            const newest = (tag: RegExp) =>
              releases.find((rel) => !rel.draft && !rel.prerelease && tag.test(rel.tag_name ?? ""));
            const latest = newest(/^v\d+\.\d+\.\d+$/);
            const android = newest(/^android-v\d+\.\d+\.\d+$/);
            const version = latest?.tag_name?.replace(/^v/, "");
            if (version) set("[data-gh-version]", version);
            // Download buttons follow a release published after the last deploy.
            const installers: Record<string, [R | undefined, RegExp]> = {
              windows: [latest, /x64-setup\.exe$/],
              mac: [latest, /universal\.dmg$/],
              android: [android, /_android\.apk$/],
            };
            document.querySelectorAll<HTMLAnchorElement>("[data-download]").forEach((link) => {
              const [release, pattern] = installers[link.dataset.download ?? ""] ?? [];
              const url = release?.assets?.find((a) => pattern?.test(a.name ?? ""))?.browser_download_url;
              if (url?.startsWith("https://github.com/amys94fr/Snap2Link/releases/download/")) link.href = url;
            });
            const androidPage = android?.html_url;
            if (androidPage?.startsWith("https://github.com/amys94fr/Snap2Link/releases/tag/")) {
              document
                .querySelectorAll<HTMLAnchorElement>('[data-releases="android"]')
                .forEach((link) => (link.href = androidPage));
            }
            const total = releases.reduce(
              (sum, rel) =>
                sum +
                (rel.assets ?? []).reduce(
                  (s, a) => s + (a.download_count ?? 0),
                  0,
                ),
              0,
            );
            set("[data-gh-downloads]", total.toLocaleString(document.documentElement.lang || "en"));
          }
        } catch {
          /* keep build-time value */
        }
      })();
    </script>
  </body>
</html>
