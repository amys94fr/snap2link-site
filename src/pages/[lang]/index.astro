---
import Home from "../../components/Home.astro";
import { DEFAULT_LANGUAGE, SITE_LANGUAGES } from "../../i18n/site";

/** One home page per language, at `/fr/`, `/pt-br/`... English stays at `/`. */
export function getStaticPaths() {
  return SITE_LANGUAGES.filter(({ code }) => code !== DEFAULT_LANGUAGE).map(({ code }) => ({
    params: { lang: code.toLowerCase() },
    props: { code },
  }));
}

const { code } = Astro.props;
---

<Home lang={code} />
