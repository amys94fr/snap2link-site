---
import Layout from "../layouts/Layout.astro";
import T from "../account-locales/en.json";
import { LANGUAGES } from "../account-languages";

type Key = keyof typeof T;

/** Lucide icons, 24x24, drawn with the current color. */
const ICONS = {
  overview: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
  links: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  profile: '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  plan: '<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>',
  security: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  help: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  settings: '<line x1="21" y1="4" x2="14" y2="4"/><line x1="10" y1="4" x2="3" y2="4"/><line x1="21" y1="12" x2="12" y2="12"/><line x1="8" y1="12" x2="3" y2="12"/><line x1="21" y1="20" x2="16" y2="20"/><line x1="12" y1="20" x2="3" y2="20"/><line x1="14" y1="2" x2="14" y2="6"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="16" y1="18" x2="16" y2="22"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  check: '<polyline points="20 6 9 17 4 12"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  unlock: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>',
  trash: '<path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>',
  menu: '<line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/>',
  signOut: '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>',
};

const icon = (name: keyof typeof ICONS) =>
  `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name]}</svg>`;

const NAV = [
  { group: null, items: [["overview", "navOverview"], ["links", "navLinks"]] },
  {
    group: "navGroupAccount",
    items: [["profile", "navProfile"], ["plan", "navPlan"], ["security", "navSecurity"], ["settings", "navSettings"]],
  },
  { group: null, items: [["help", "navHelp"]] },
] as const;

const PLAN_ROWS: Key[][] = [
  ["rowCaptures", "valueGuestCaptures", "valueFreeCaptures", "valuePaidCaptures"],
  ["rowLinks", "valueGuestLinks", "valueFreeLinks", "valuePaidLinks"],
  ["rowLife", "valueGuestLife", "valueFreeLife", "valuePaidLife"],
  ["rowKeep", "valueGuestKeep", "valueFreeKeep", "valuePaidKeep"],
  ["rowHistory", "valueNo", "valueYes", "valueYes"],
];
---

<Layout title={T.title} description={T.description} lang="en">
  <meta slot="head" name="robots" content="noindex" />

  <div id="account">
    <div id="view-loading" class="acc-loading" aria-busy="true"></div>

    <div id="view-auth" class="acc-auth-page" hidden>
      <header class="acc-auth-top">
        <a href="/" class="nav-brand" aria-label={T.home} data-t-aria="home">
          <img src="/assets/logo-app-icon.png" width="28" height="28" alt="" style="border-radius: 6px;" />
          <span>Snap<b>2</b>Link</span>
        </a>
      </header>

      <main class="acc-auth">
        <section id="auth-email">
          <h1><span data-t="signInTitle">{T.signInTitle}</span></h1>
          <p><span data-t="signInLead">{T.signInLead}</span></p>
          <div id="google-block" class="acc-google-block" hidden>
            <div id="google-button" class="acc-google"></div>
            <button id="google-demo" type="button" class="btn outline lg acc-google-demo" hidden>
              <svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
              <span data-t="continueGoogle">{T.continueGoogle}</span>
            </button>
            <p class="acc-or"><span data-t="or">{T.or}</span></p>
          </div>
          <form id="form-email" novalidate>
            <label for="field-email"><span data-t="email">{T.email}</span></label>
            <input id="field-email" type="email" autocomplete="email" inputmode="email" required />
            <div id="turnstile" class="acc-turnstile"></div>
            <p id="email-error" class="acc-error" role="alert" hidden></p>
            <button type="submit" class="btn primary lg"><span data-t="sendCode">{T.sendCode}</span></button>
          </form>
          <p class="acc-muted"><span data-t="noAccount">{T.noAccount}</span></p>
        </section>

        <section id="auth-code" hidden>
          <h1><span data-t="codeTitle">{T.codeTitle}</span></h1>
          <p><span data-t="codeLead">{T.codeLead}</span> <strong id="code-email"></strong></p>
          <form id="form-code" novalidate>
            <label for="field-code"><span data-t="code">{T.code}</span></label>
            <input id="field-code" class="acc-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
            <p id="code-error" class="acc-error" role="alert" hidden></p>
            <button type="submit" class="btn primary lg"><span data-t="verify">{T.verify}</span></button>
          </form>
          <button id="code-back" type="button" class="btn ghost"><span data-t="otherEmail">{T.otherEmail}</span></button>
        </section>

        <section id="auth-error" hidden>
          <p role="alert"><span data-t="loadError">{T.loadError}</span></p>
          <button id="error-retry" type="button" class="btn outline"><span data-t="retry">{T.retry}</span></button>
        </section>
      </main>
    </div>

    <div id="view-app" class="acc-shell" hidden>
      <div class="acc-mobile-bar">
        <button id="menu-open" type="button" class="acc-icon-btn" aria-label={T.menu} data-t-aria="menu" aria-expanded="false" aria-controls="side">
          <Fragment set:html={icon("menu")} />
        </button>
        <a href="/" class="nav-brand" aria-label={T.home} data-t-aria="home">
          <img src="/assets/logo-app-icon.png" width="24" height="24" alt="" style="border-radius: 5px;" />
          <span>Snap<b>2</b>Link</span>
        </a>
      </div>
      <button id="menu-scrim" type="button" class="acc-scrim" aria-label={T.closeMenu} data-t-aria="closeMenu" hidden></button>

      <aside id="side" class="acc-side">
        <a href="/" class="nav-brand acc-side-brand" aria-label={T.home} data-t-aria="home">
          <img src="/assets/logo-app-icon.png" width="28" height="28" alt="" style="border-radius: 6px;" />
          <span>Snap<b>2</b>Link</span>
        </a>

        <nav aria-label={T.navLabel} data-t-aria="navLabel" class="acc-nav">
          {NAV.map(({ group, items }) => (
            <div class="acc-nav-group">
              {group && <p class="acc-nav-title" data-t={group}>{T[group]}</p>}
              {items.map(([id, label]) => (
                <a href={`#${id}`} data-nav={id}>
                  <Fragment set:html={icon(id)} />
                  <span data-t={label}>{T[label]}</span>
                  {id === "links" && <span id="nav-count" class="acc-count"></span>}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="acc-user">
          <span id="user-avatar" class="acc-avatar" aria-hidden="true"></span>
          <div class="acc-user-text">
            <p id="user-name"></p>
            <p id="user-email" class="acc-muted"></p>
          </div>
          <button id="sign-out" type="button" class="acc-icon-btn" aria-label={T.signOut} data-t-aria="signOut" >
            <Fragment set:html={icon("signOut")} />
          </button>
        </div>
      </aside>

      <main class="acc-content">
        <p id="action-error" class="acc-error acc-banner" role="alert" hidden></p>
        <p id="copy-status" class="acc-sr" role="status"></p>

        <section data-page="overview">
          <header class="acc-head">
            <h1 id="hello" tabindex="-1"></h1>
            <p><span data-t="overviewLead">{T.overviewLead}</span></p>
          </header>

          <div class="acc-stats">
            <article>
              <h2><span data-t="capturesToday">{T.capturesToday}</span></h2>
              <p class="acc-stat" id="stat-captures"></p>
              <div class="acc-bar"><span id="bar-captures"></span></div>
              <p class="acc-muted"><span data-t="capturesHint">{T.capturesHint}</span></p>
            </article>
            <article>
              <h2><span data-t="activeLinks">{T.activeLinks}</span></h2>
              <p class="acc-stat" id="stat-links"></p>
              <div class="acc-bar"><span id="bar-links"></span></div>
              <p class="acc-muted"><span data-t="activeHint">{T.activeHint}</span></p>
            </article>
            <article>
              <h2><span data-t="keptLinks">{T.keptLinks}</span></h2>
              <p class="acc-stat" id="stat-kept"></p>
              <div class="acc-bar"><span id="bar-kept"></span></div>
              <p class="acc-muted"><span data-t="keptHint">{T.keptHint}</span></p>
            </article>
          </div>

          <div class="acc-section-head">
            <h2><span data-t="recent">{T.recent}</span></h2>
            <a href="#links" class="btn ghost sm"><span data-t="seeAll">{T.seeAll}</span></a>
          </div>
          <div class="acc-rows-wrap" id="recent-table">
            <table class="acc-rows">
              <thead>
                <tr>
                  <th scope="col" data-t="colPreview">{T.colPreview}</th>
                  <th scope="col" data-t="colLink">{T.colLink}</th>
                  <th scope="col" data-t="colDate">{T.colDate}</th>
                  <th scope="col" data-t="colExpires">{T.colExpires}</th>
                  <th scope="col" class="acc-col-actions" data-t="colActions">{T.colActions}</th>
                </tr>
              </thead>
              <tbody id="recent"></tbody>
            </table>
          </div>
          <div class="acc-empty" data-empty hidden>
            <h3><span data-t="emptyTitle">{T.emptyTitle}</span></h3>
            <p><span data-t="emptyLead">{T.emptyLead}</span></p>
            <a class="btn primary" href="/#install"><span data-t="emptyCta">{T.emptyCta}</span></a>
          </div>

          <div class="acc-card-panel acc-row">
            <div>
              <h2><span data-t="planCurrent">{T.planCurrent}</span> <span class="acc-badge"><span data-t="planFree">{T.planFree}</span></span></h2>
              <p><span data-t="planCardLead">{T.planCardLead}</span></p>
            </div>
            <a href="#plan" class="btn outline"><span data-t="seePlans">{T.seePlans}</span></a>
          </div>
        </section>

        <section data-page="links" hidden>
          <header class="acc-head">
            <h1 tabindex="-1"><span data-t="navLinks">{T.navLinks}</span></h1>
            <p><span data-t="linksLead">{T.linksLead}</span></p>
          </header>
          <div class="acc-slots-bar">
            <div class="acc-slots">
              <div id="slot-meter" class="acc-slot-meter" aria-hidden="true"></div>
              <p id="slots-used" class="acc-strong"></p>
              <p id="slots-kept" class="acc-muted"></p>
            </div>
            <div class="acc-filter" role="group" aria-label={T.filterLabel} data-t-aria="filterLabel">
            <button type="button" data-filter="all" aria-pressed="true"><span data-t="filterAll">{T.filterAll}</span></button>
            <button type="button" data-filter="kept" aria-pressed="false"><span data-t="filterKept">{T.filterKept}</span></button>
            </div>
          </div>
          <div class="acc-rows-wrap" id="links-table">
            <table class="acc-rows">
              <thead>
                <tr>
                  <th scope="col" data-t="colPreview">{T.colPreview}</th>
                  <th scope="col" data-t="colLink">{T.colLink}</th>
                  <th scope="col" data-t="colDate">{T.colDate}</th>
                  <th scope="col" data-t="colExpires">{T.colExpires}</th>
                  <th scope="col" class="acc-col-actions" data-t="colActions">{T.colActions}</th>
                </tr>
              </thead>
              <tbody id="links"></tbody>
            </table>
          </div>
          
          <div id="kept-empty" class="acc-empty" hidden><p><span data-t="emptyKept">{T.emptyKept}</span></p></div>
        </section>

        <section data-page="profile" hidden>
          <header class="acc-head">
            <h1 tabindex="-1"><span data-t="navProfile">{T.navProfile}</span></h1>
            <p><span data-t="profileLead">{T.profileLead}</span></p>
          </header>

          <form id="form-profile" class="acc-card-panel" novalidate>
            <h2><span data-t="profileInfo">{T.profileInfo}</span></h2>
            <div class="acc-profile-head">
              <span id="profile-avatar" class="acc-avatar lg" aria-hidden="true"></span>
              <div class="acc-fields">
                <div class="acc-field">
                  <label for="field-name"><span data-t="name">{T.name}</span></label>
                  <input id="field-name" type="text" autocomplete="name" maxlength="60" />
                  <p class="acc-muted"><span data-t="nameHint">{T.nameHint}</span></p>
                </div>
              </div>
            </div>
            <div class="acc-form-end">
              <p id="profile-saved" class="acc-success" role="status" hidden><span data-t="saved">{T.saved}</span></p>
              <button type="submit" class="btn primary"><span data-t="save">{T.save}</span></button>
            </div>
          </form>

          <div class="acc-card-panel">
            <div class="acc-row">
              <div>
                <h2><span data-t="emailTitle">{T.emailTitle}</span></h2>
                <p id="email-current" class="acc-strong"></p>
                <p class="acc-muted"><span data-t="emailLead">{T.emailLead}</span></p>
              </div>
              <button id="email-edit" type="button" class="btn outline"><span data-t="changeEmail">{T.changeEmail}</span></button>
            </div>

            <form id="form-new-email" class="acc-inline-form" novalidate hidden>
              <div class="acc-field">
                <label for="field-new-email"><span data-t="newEmail">{T.newEmail}</span></label>
                <input id="field-new-email" type="email" autocomplete="email" inputmode="email" />
                <p class="acc-muted"><span data-t="newEmailHint">{T.newEmailHint}</span></p>
              </div>
              <div class="acc-field" id="new-code-field" hidden>
                <label for="field-new-code"><span data-t="code">{T.code}</span></label>
                <input id="field-new-code" class="acc-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" />
              </div>
              <p id="new-email-error" class="acc-error" role="alert" hidden></p>
              <div class="acc-form-end">
                <button id="email-cancel" type="button" class="btn ghost"><span data-t="cancel">{T.cancel}</span></button>
                <button id="email-submit" type="submit" class="btn primary"><span data-t="sendCode">{T.sendCode}</span></button>
              </div>
            </form>
            <p id="email-done" class="acc-success" role="status" hidden><span data-t="emailChanged">{T.emailChanged}</span></p>
          </div>

          <div class="acc-card-panel acc-row">
            <div>
              <h2><span data-t="dataTitle">{T.dataTitle}</span></h2>
              <p><span data-t="dataLead">{T.dataLead}</span></p>
            </div>
            <button id="export-data" type="button" class="btn outline"><span data-t="exportData">{T.exportData}</span></button>
          </div>
        </section>

        <section data-page="plan" hidden>
          <header class="acc-head">
            <h1 tabindex="-1"><span data-t="navPlan">{T.navPlan}</span></h1>
            <p><span data-t="planLead">{T.planLead}</span></p>
          </header>

          <div class="acc-table-wrap">
            <table class="acc-table">
              <thead>
                <tr>
                  <td></td>
                  <th scope="col"><span data-t="planGuest">{T.planGuest}</span></th>
                  <th scope="col" class="is-current"><span data-t="planFree">{T.planFree}</span><span class="acc-badge brand"><span data-t="planCurrent">{T.planCurrent}</span></span></th>
                  <th scope="col"><span data-t="planPaid">{T.planPaid}</span><span class="acc-badge"><span data-t="planSoonBadge">{T.planSoonBadge}</span></span></th>
                </tr>
              </thead>
              <tbody>
                {PLAN_ROWS.map(([label, guest, free, paid]) => (
                  <tr>
                    <th scope="row" data-t={label}>{T[label]}</th>
                    <td data-t={guest}>{T[guest]}</td>
                    <td class="is-current" data-t={free}>{T[free]}</td>
                    <td data-t={paid}>{T[paid]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="acc-muted acc-after"><span data-t="planSoon">{T.planSoon}</span></p>
        </section>

        <section data-page="security" hidden>
          <header class="acc-head">
            <h1 tabindex="-1"><span data-t="navSecurity">{T.navSecurity}</span></h1>
            <p><span data-t="securityLead">{T.securityLead}</span></p>
          </header>

          <div class="acc-card-panel">
            <h2><span data-t="methodsTitle">{T.methodsTitle}</span></h2>
            <ul class="acc-list">
              <li>
                <div><p class="acc-strong"><span data-t="methodEmail">{T.methodEmail}</span></p><p class="acc-muted"><span data-t="methodEmailHint">{T.methodEmailHint}</span></p></div>
                <span class="acc-badge success"><span data-t="active">{T.active}</span></span>
              </li>
              <li>
                <div><p class="acc-strong"><span data-t="methodGoogle">{T.methodGoogle}</span></p><p class="acc-muted"><span data-t="methodGoogleHint">{T.methodGoogleHint}</span></p></div>
                <span class="acc-badge success"><span data-t="active">{T.active}</span></span>
              </li>
            </ul>
          </div>

          <div class="acc-card-panel">
            <div class="acc-row">
              <div>
                <h2><span data-t="sessionsTitle">{T.sessionsTitle}</span></h2>
                <p><span data-t="sessionsLead">{T.sessionsLead}</span></p>
              </div>
              <button id="sessions-close-all" type="button" class="btn outline"><span data-t="sessionsCloseAll">{T.sessionsCloseAll}</span></button>
            </div>
            <ul id="sessions" class="acc-list"></ul>
          </div>

          <div class="acc-card-panel acc-row acc-danger">
            <div>
              <h2><span data-t="dangerTitle">{T.dangerTitle}</span></h2>
              <p><span data-t="dangerLead">{T.dangerLead}</span></p>
            </div>
            <button id="delete-account" type="button" class="btn acc-delete"><span data-t="dangerButton">{T.dangerButton}</span></button>
          </div>
        </section>

        <section data-page="settings" hidden>
          <header class="acc-head">
            <h1 tabindex="-1"><span data-t="navSettings">{T.navSettings}</span></h1>
            <p><span data-t="settingsLead">{T.settingsLead}</span></p>
          </header>

          <div class="acc-card-panel">
            <h2><span data-t="languageTitle">{T.languageTitle}</span></h2>
            <p><span data-t="languageLead">{T.languageLead}</span></p>
            <div class="acc-field acc-narrow">
              <label for="field-language"><span data-t="languageLabel">{T.languageLabel}</span></label>
              <select id="field-language">
                {LANGUAGES.map(({ code, name }) => <option value={code}>{name}</option>)}
              </select>
            </div>
          </div>
        </section>

        <section data-page="help" hidden>
          <header class="acc-head">
            <h1 tabindex="-1"><span data-t="navHelp">{T.navHelp}</span></h1>
            <p><span data-t="helpLead">{T.helpLead}</span></p>
          </header>
          <div class="acc-help">
            <article class="acc-card-panel">
              <h2><span data-t="helpAppTitle">{T.helpAppTitle}</span></h2>
              <p><span data-t="helpAppLead">{T.helpAppLead}</span></p>
              <a class="btn primary" href="/#install"><span data-t="helpAppCta">{T.helpAppCta}</span></a>
            </article>
            <article class="acc-card-panel">
              <h2><span data-t="helpContactTitle">{T.helpContactTitle}</span></h2>
              <p><span data-t="helpContactLead">{T.helpContactLead}</span></p>
              <a class="btn outline" href="mailto:contact@snap2link.app">contact@snap2link.app</a>
            </article>
            <article class="acc-card-panel">
              <h2><span data-t="helpLegalTitle">{T.helpLegalTitle}</span></h2>
              <p><span data-t="helpLegalLead">{T.helpLegalLead}</span></p>
              <a class="acc-link" id="legal-privacy" href="/privacy/"><span data-t="helpPrivacy">{T.helpPrivacy}</span></a>
