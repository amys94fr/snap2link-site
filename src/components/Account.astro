        <td class="acc-cell-thumb"><span class="acc-free-thumb"></span></td>
        <td class="acc-cell-free" colspan="4">
          <span class="acc-strong" data-free></span>
          <span class="acc-muted" data-free-hint></span>
        </td>
      </tr>
    </template>

    <template id="session-row">
      <li>
        <div><p class="acc-strong" data-name></p><p class="acc-muted" data-since></p></div>
        <span class="acc-badge success" data-current hidden></span>
        <button type="button" class="btn outline sm" data-close></button>
      </li>
    </template>
  </div>

  <script>
    import "../scripts/account";
  </script>
</Layout>

