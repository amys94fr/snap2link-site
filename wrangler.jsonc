// Cloudflare Workers + Static Assets config — drives the deploy from
// the new unified "Workers & Pages" flow. Astro builds to ./dist and we
// hand that whole directory to Cloudflare's edge as static assets.
//
// No Worker script on purpose: requests to static assets are free and
// unlimited, while the Workers quota is shared with the whole account. A flood
// on another Worker can't take the site down this way.
//
// www -> apex and /index.html -> / are Redirect Rules on the snap2link.app zone
// in the Cloudflare dashboard. HTML headers live in public/_headers.
//
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snap2link-site",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
